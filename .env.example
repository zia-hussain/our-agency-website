# ===== SUPABASE CONFIGURATION =====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only lead delivery. Add these in Vercel, not in client-side code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_key
LEAD_FROM_EMAIL=Zumetrix Labs <hello@zumetrix.com>
LEAD_NOTIFICATION_EMAIL=ziahussain@zumetrix.com,hello@zumetrix.com

# Server-only Airtable mirror. Never expose these as VITE_* variables.
AIRTABLE_API_KEY=pat_your_token
AIRTABLE_BASE_ID=app_your_base_id
AIRTABLE_LEADS_TABLE=Website Leads
AIRTABLE_REVIEWS_TABLE=Client Reviews

# ===== PRODUCT RESCUE / OFFER SYSTEM =====
# Full setup checklist: see README-OFFER-SYSTEM.md at the repo root.
# Server-only. Same Airtable base/key as above — a new table in it.
AIRTABLE_OFFER_APPLICATIONS_TABLE=Offer Applications

# Notion integration token (Settings -> Connections -> Develop or manage
# integrations, in the workspace that owns the Offer Pipeline) and the
# Offer Pipeline database's id. The integration must also be explicitly
# shared with that database from Notion's UI — the token alone isn't enough.
NOTION_API_KEY=secret_your_integration_token
NOTION_OFFER_PIPELINE_DB_ID=your_database_id

# Only needed if the real Offer Pipeline uses different property names than
# the defaults this adapter assumes (Opportunity/Stage/Fit/Source/Client/
# Company/Value/Decision Needed/Next Action/Next Action Date/Owner/
# Application Ref). Leave unset to use the defaults.
# NOTION_PROP_OPPORTUNITY=Opportunity
# NOTION_PROP_STAGE=Stage
# NOTION_PROP_FIT=Fit
# NOTION_PROP_SOURCE=Source
# NOTION_PROP_CLIENT=Client
# NOTION_PROP_COMPANY=Company
# NOTION_PROP_VALUE=Value
# NOTION_PROP_DECISION_NEEDED=Decision Needed
# NOTION_PROP_NEXT_ACTION=Next Action
# NOTION_PROP_NEXT_ACTION_DATE=Next Action Date
# NOTION_PROP_OWNER=Owner
# NOTION_PROP_APPLICATION_REF=Application Ref
# NOTION_DEFAULT_OWNER=Zia

# Optional: pre-links every new opportunity to the "Product Rescue
# Assessment" row in the Offer Library, if the Offer Pipeline's "Offer"
# column is a relation to it.
# NOTION_OFFER_RELATION_PROPERTY=Offer
# NOTION_PRODUCT_RESCUE_OFFER_PAGE_ID=

# Recipients for new-application / payment-verified notifications. Falls
# back to LEAD_NOTIFICATION_EMAIL, then hello@zumetrix.com, if unset.
OFFER_NOTIFICATION_EMAIL=ziahussain@zumetrix.com

# A long random secret, known only to you (and, later, a real payment
# provider's webhook config). Gates /api/internal/payment-verified and
# /api/internal/set-fit — never put this in client-side code. Generate one
# with: openssl rand -hex 32
INTERNAL_OPS_TOKEN=

# Payment boundary — unset today on purpose (see api/_lib/payment.js). Once
# a provider is chosen, set PAYMENT_PROVIDER to its name and
# PAYMENT_LINK_STANDARD to its hosted payment-link URL for the $750
# assessment. Until then, acceptance emails show an honest "we'll follow up
# with a secure payment link" line instead of a button.
# PAYMENT_PROVIDER=
# PAYMENT_LINK_STANDARD=
